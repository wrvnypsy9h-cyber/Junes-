<!doctype html>
<html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#f7f3ec"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="apple-mobile-web-app-title" content="Junes Daily"><link rel="manifest" href="manifest.webmanifest"><link rel="apple-touch-icon" href="icon.svg"><title>JUNES DAILY</title><style>
:root{--ink:#29332d;--muted:#788078;--paper:#f7f3ec;--card:#fffdf8;--green:#617b68;--line:#e8e2d8;--peach:#f4e3d7}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding:env(safe-area-inset-top) 16px env(safe-area-inset-bottom)}main{max-width:650px;margin:auto;padding:24px 0 48px}header{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.brand{font-size:12px;letter-spacing:.18em;font-weight:700;color:var(--green)}h1{font-size:28px;margin:6px 0 0}.date{color:var(--muted);font-size:13px}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:18px;margin:14px 0}.welcome{background:#e9eee6}.times{font-size:13px;color:var(--muted);margin-top:6px}.section-title{font-size:18px;margin:0 0 12px}.row{display:flex;gap:8px}.row input,.row select,input[type=date],input[type=time]{min-width:0;border:1px solid var(--line);background:white;border-radius:12px;padding:12px;font:inherit;color:var(--ink)}.row input[type=text]{flex:1}.row button,button{border:0;border-radius:12px;background:var(--green);color:white;padding:11px 14px;font:inherit;cursor:pointer}.task{display:flex;align-items:flex-start;gap:11px;padding:12px 2px;border-bottom:1px solid var(--line)}.task:last-child{border:0}.task input{margin-top:5px;accent-color:var(--green);width:18px;height:18px}.task .text{flex:1;overflow-wrap:anywhere}.task.done .text{text-decoration:line-through;color:var(--muted)}.meta{display:block;color:var(--muted);font-size:12px;margin-top:4px}.del{background:transparent;color:var(--muted);padding:2px 8px;font-size:20px}.empty{color:var(--muted);font-size:14px;padding:8px 0}.form{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.form input:first-child{grid-column:1/-1}.form button{grid-column:1/-1}.parking{background:#f8eee6}.small{font-size:13px;color:var(--muted);line-height:1.5}.actions{display:flex;gap:8px}.actions button{font-size:13px}.progress{height:7px;border-radius:9px;background:#dce4da;margin-top:12px;overflow:hidden}.progress span{display:block;height:100%;width:0;background:var(--green);transition:width .2s}footer{text-align:center;color:var(--muted);font-size:12px;padding:14px}
</style></head><body><main><header><div><div class="brand">JUNES DAILY</div><h1>วันนี้ค่อย ๆ ไป 🌿</h1></div><div class="date" id="date"></div></header><section class="card welcome"><b>เริ่มใหม่ได้ทุกครั้งที่ต้องการ</b><div class="times">ตื่น 08:00 · พักและปิดวัน 00:00</div><div class="progress"><span id="progress"></span></div><div class="small" id="count" style="margin-top:8px"></div></section><section class="card"><h2 class="section-title">งานวันนี้</h2><form id="addForm" class="row"><input id="taskInput" type="text" placeholder="เพิ่มงานหนึ่งอย่าง…" aria-label="ชื่องาน" required><button>เพิ่ม</button></form><div class="form"><input id="deadlineDate" type="date" aria-label="วันกำหนดส่ง"><input id="deadlineTime" type="time" aria-label="เวลากำหนดส่ง"><select id="energy" aria-label="ขนาดงาน"><option value="5 นาที">เริ่ม 5 นาที</option><option value="15 นาที">โฟกัส 15 นาที</option><option value="25 นาที">โฟกัส 25 นาที</option><option value="ไม่กำหนด">ไม่กำหนดเวลา</option></select><button id="saveTask">บันทึกงาน</button></div><div id="tasks"></div></section><section class="card parking"><h2 class="section-title">Parking lot · ไว้พรุ่งนี้ก็ได้</h2><p class="small">ไอเดียหรืองานที่ยังไม่ต้องทำวันนี้ จดไว้ก่อนแล้วกลับมาที่งานตรงหน้า</p><form id="parkForm" class="row"><input id="parkInput" type="text" placeholder="พักเรื่องนี้ไว้…" aria-label="งานที่พักไว้" required><button>จดไว้</button></form><div id="parkingList"></div></section><section class="card"><h2 class="section-title">ปิดวันอย่างใจดี</h2><div class="small">ก่อนพักตอนเที่ยงคืน: เลือกงานที่ยังไม่เสร็จ ย้ายไป Parking lot ได้ แล้วเขียนงานแรกของวันพรุ่งนี้ไว้เพียงหนึ่งอย่าง</div><div class="actions" style="margin-top:12px"><button id="resetDay">เริ่มวันใหม่</button><button id="export">สำรองข้อมูล</button><label style="display:flex;align-items:center;border:1px solid var(--line);border-radius:12px;padding:8px 10px;font-size:13px;cursor:pointer">นำเข้าข้อมูล<input id="import" type="file" accept="application/json" hidden></label></div><div class="small" style="margin-top:8px">ข้อมูลเก็บไว้ในเบราว์เซอร์เครื่องนี้ แนะนำสำรองข้อมูลเป็นระยะ</div></section><footer>หนึ่งอย่างในแต่ละครั้งก็พอ ✨</footer></main><script>
const key='junes-daily-v1';let db=JSON.parse(localStorage.getItem(key)||'{"tasks":[],"parking":[]}');const today=()=>new Date().toLocaleDateString('en-CA');function save(){localStorage.setItem(key,JSON.stringify(db));render()}document.getElementById('date').textContent=new Date().toLocaleDateString('th-TH',{weekday:'long',day:'numeric',month:'long'});function addTask(text,deadline,energy){db.tasks.push({id:crypto.randomUUID(),text,deadline,energy,done:false,date:today()});save()}function render(){let ts=db.tasks.filter(t=>t.date===today());document.getElementById('tasks').innerHTML=ts.length?ts.map(t=>`<div class="task ${t.done?'done':''}"><input type="checkbox" ${t.done?'checked':''} data-id="${t.id}" aria-label="ทำเสร็จแล้ว"><div class="text">${esc(t.text)}<span class="meta">${esc(t.energy||'')} ${t.deadline?'· กำหนดส่ง '+new Date(t.deadline+'T00:00').toLocaleDateString('th-TH')+(t.time?' '+t.time:''):''}</span></div><button class="del" data-del="${t.id}" aria-label="ลบ">×</button></div>`).join(''):'<div class="empty">ยังไม่มีงานที่ต้องทำวันนี้ — เพิ่มแค่อย่างแรกก่อนก็ได้</div>';let done=ts.filter(t=>t.done).length;document.getElementById('count').textContent=`เสร็จแล้ว ${done} จาก ${ts.length} งาน`;document.getElementById('progress').style.width=ts.length?`${done/ts.length*100}%`:'0%';document.getElementById('parkingList').innerHTML=db.parking.length?db.parking.map(t=>`<div class="task"><div class="text">${esc(t.text)}</div><button class="del" data-pdel="${t.id}" aria-label="ลบ">×</button><button data-move="${t.id}" style="padding:6px 9px;font-size:12px">ทำวันนี้</button></div>`).join(''):'<div class="empty">ที่จอดพักยังว่าง</div>'}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}document.getElementById('saveTask').onclick=e=>{e.preventDefault();let v=document.getElementById('taskInput').value.trim();if(!v)return;addTask(v,document.getElementById('deadlineDate').value,document.getElementById('energy').value);document.getElementById('addForm').reset();document.getElementById('deadlineDate').value='';document.getElementById('deadlineTime').value=''};document.getElementById('addForm').onsubmit=e=>{e.preventDefault();document.getElementById('saveTask').click()};document.getElementById('parkForm').onsubmit=e=>{e.preventDefault();db.parking.push({id:crypto.randomUUID(),text:document.getElementById('parkInput').value.trim()});document.getElementById('parkInput').value='';save()};document.addEventListener('change',e=>{if(e.target.matches('[data-id]')){let t=db.tasks.find(x=>x.id===e.target.dataset.id);if(t)t.done=e.target.checked;save()}});document.addEventListener('click',e=>{if(e.target.dataset.del){db.tasks=db.tasks.filter(t=>t.id!==e.target.dataset.del);save()}if(e.target.dataset.pdel){db.parking=db.parking.filter(t=>t.id!==e.target.dataset.pdel);save()}if(e.target.dataset.move){let i=db.parking.findIndex(t=>t.id===e.target.dataset.move),t=db.parking.splice(i,1)[0];addTask(t.text,'','เริ่ม 5 นาที');save()}});document.getElementById('resetDay').onclick=()=>{let pending=db.tasks.filter(t=>t.date===today()&&!t.done);pending.forEach(t=>db.parking.push({id:crypto.randomUUID(),text:t.text}));db.tasks=db.tasks.filter(t=>t.date!==today());save()};document.getElementById('export').onclick=()=>{let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(db,null,2)],{type:'application/json'}));a.download='junes-daily-backup.json';a.click();URL.revokeObjectURL(a.href)};document.getElementById('import').onchange=e=>{let f=e.target.files[0];if(f){let r=new FileReader();r.onload=()=>{try{db=JSON.parse(r.result);save()}catch{alert('ไฟล์นี้อ่านไม่ได้')}};r.readAsText(f)}};render();if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js').catch(()=>{});
</script></body></html>
